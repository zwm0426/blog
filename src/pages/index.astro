---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryArchive from '../components/StoryArchive.astro';
import { getStories } from '../lib/stories';
import { timeline } from '../data/timeline';
import { withBase } from '../../site.config.mjs';
const stories = await getStories();
---
<BaseLayout>
  <section class="home-hero" aria-labelledby="home-title">
    <p class="eyebrow">A PERSONAL ARCHIVE <span>·</span> BY WEIMING</p>
    <h1 id="home-title">一些小事<span lang="en">Small Histories</span></h1>
    <div class="hero-bottom">
      <div class="hero-description">
        <p lang="en">Notes on places I’ve been, things I’ve built,<br class="desktop-break" /> and moments I don’t want to forget.</p>
        <p>关于去过的地方、做过的东西，<wbr />以及一些不想忘记的瞬间。</p>
      </div>
      <span class="hero-side-note" aria-hidden="true">生活的注脚</span>
    </div>
  </section>
  <section class="home-intro" aria-labelledby="intro-title">
    <span class="margin-label" lang="en">A small note</span>
    <div>
      <h2 id="intro-title">这里记录一些不值得写进简历，<br class="desktop-break" />但值得记住的事。</h2>
      <p>生活里有很多看似微小的片段，它们或许不会带来什么具体的成就，却在某个时刻，悄悄塑造了我。这个网站是一个个人的记录，用来保存这些小小的经历、想法和瞬间。</p>
    </div>
  </section>
  <section class="home-stories" aria-labelledby="stories-title">
    <div class="section-heading"><h2 id="stories-title">故事 <span lang="en">Stories</span></h2><a class="text-link" href={withBase('/stories/')}>全部故事 <span aria-hidden="true">→</span></a></div>
    <StoryArchive stories={stories} />
  </section>
  <section class="timeline-teaser" aria-labelledby="timeline-title">
    <div class="section-heading"><h2 id="timeline-title">时间的刻度 <span lang="en">Through the years</span></h2><span class="section-note">一些片段，连成一条线。</span></div>
    <ol>{timeline.map((entry) => <li><a href={withBase(`/timeline/#year-${entry.year}`)} aria-label={`${entry.year}，${entry.title}`}><span class="teaser-dot" />{entry.year}</a></li>)}</ol>
    <a class="text-link" href={withBase('/timeline/')}>探索完整时间线 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
