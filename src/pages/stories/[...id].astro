---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chineseDate, getStories, storyDateLabel, storyUrl, type Story } from '../../lib/stories';
import { withBase } from '../../../site.config.mjs';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, index) => ({
    params: { id: story.id },
    props: { story, newer: stories[index - 1], older: stories[index + 1] },
  }));
}
interface Props { story: Story; newer?: Story; older?: Story; }
const { story, newer, older } = Astro.props;
const { Content } = await render(story);
---
<BaseLayout title={story.data.title} description={story.data.description} type="article" image={story.data.cover} published={story.data.publishedAt} modified={story.data.updatedAt} draft={story.data.draft}>
  <article class="article">
    <header class="article-heading">
      <a class="eyebrow article-kicker" href={withBase('/stories/')}>STORIES <span aria-hidden="true">/</span> 故事</a>
      <h1>{story.data.title}</h1>
      <div class="article-meta">
        <div class="story-context"><time datetime={story.data.storyDate.toISOString()}>{storyDateLabel(story)}</time>{story.data.location && <span>{story.data.location}</span>}</div>
        <div class="writing-context"><span>写于 <time datetime={story.data.writtenAt.toISOString()}>{chineseDate(story.data.writtenAt)}</time></span>{story.data.updatedAt && <span>更新于 <time datetime={story.data.updatedAt.toISOString()}>{chineseDate(story.data.updatedAt)}</time></span>}{story.data.draft && <span class="draft-label">草稿 · 仅本地可见</span>}</div>
      </div>
      {story.data.description && <p class="article-description">{story.data.description}</p>}
    </header>
    {story.data.cover && <figure class="article-cover"><img src={withBase(story.data.cover)} alt={story.data.coverAlt} fetchpriority="high" />{story.data.coverCaption && <figcaption>{story.data.coverCaption}</figcaption>}</figure>}
    <div class="prose"><Content /></div>
    <div class="article-end" aria-hidden="true">· · ·</div>
    <footer class="article-footer">
      <a class="text-link" href={withBase('/stories/')}>← Back to Stories</a>
      {(older || newer) && <nav class="article-pagination" aria-label="相邻故事">
        <div>{older && <a href={storyUrl(older)}><span>上一篇 · 更早的故事</span>{older.data.title}</a>}</div>
        <div>{newer && <a href={storyUrl(newer)}><span>下一篇 · 更新的故事</span>{newer.data.title}</a>}</div>
      </nav>}
    </footer>
  </article>
</BaseLayout>
