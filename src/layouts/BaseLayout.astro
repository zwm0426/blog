---
import '../styles/global.css';
import { siteConfig, withBase } from '../../site.config.mjs';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  published?: Date;
  modified?: Date;
  draft?: boolean;
  canonicalPath?: string;
  noindex?: boolean;
}
const { title, description = siteConfig.description, type = 'website', image, published, modified, draft = false, canonicalPath, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(canonicalPath ? withBase(canonicalPath) : Astro.url.pathname, Astro.site);
const navigation = [
  { label: 'Stories', path: '/stories/' },
  { label: 'Timeline', path: '/timeline/' },
  { label: 'About', path: '/about/' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f6f1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    {(draft || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh_CN" />
    {image && <meta property="og:image" content={new URL(withBase(image), Astro.site)} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={withBase('/')} aria-label="一些小事，首页">一些小事<span lang="en">Small Histories</span></a>
        <nav aria-label="主导航">
          {navigation.map(({ label, path }) => (
            <a href={withBase(path)} aria-current={Astro.url.pathname.startsWith(withBase(path)) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div><span class="footer-name">一些小事</span><span class="footer-note">把日子，慢慢写下来。</span></div>
        <div class="footer-meta"><span>© {new Date().getFullYear()} Weiming</span><a href={withBase('/rss.xml')}>RSS <span aria-hidden="true">↗</span></a></div>
      </footer>
    </div>
  </body>
</html>
